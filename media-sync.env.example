MEDIA_DIGEST_BASE_URL=https://media-digest.<your-subdomain>.workers.dev
MEDIA_DIGEST_DEVICE_ID=<paired-device-id>
MEDIA_DIGEST_DEVICE_SECRET=<paired-device-secret>
MEDIA_DIGEST_VAULT_ROOT=C:\repositories\secondbrain
MEDIA_DIGEST_WHISPER_MODEL=small
MEDIA_DIGEST_TRANSCRIPTION_LANGUAGE=pt
MEDIA_DIGEST_WHISPER_DEVICE=cpu
MEDIA_DIGEST_WHISPER_COMPUTE_TYPE=int8
MEDIA_DIGEST_YTDLP=yt-dlp
MEDIA_DIGEST_FFMPEG=ffmpeg
# Optional for private/age-gated/session-bound URLs:
# MEDIA_DIGEST_YTDLP_COOKIES=C:\path\to\cookies.txt
